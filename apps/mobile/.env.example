# Copy this to .env for local development, and set the real value
# per-environment in eas.json's build profiles for actual builds.
#
# Local dev (phone on same WiFi as your laptop):
EXPO_PUBLIC_API_URL=http://192.168.43.99:3001

# Production (once the backend is deployed to a real host):
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com
